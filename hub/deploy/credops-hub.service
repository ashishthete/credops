[Unit]
Description=CredOps Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=credops-hub
Group=credops-hub
WorkingDirectory=/opt/credops-hub
ExecStart=/usr/bin/node /opt/credops-hub/dist/credops-hub.mjs serve --config /etc/credops-hub/hub.config.json
Restart=on-failure
RestartSec=5
UMask=0077

# The master key is handed over as a systemd credential; set "masterKeyFile" in the config
# to "${CREDENTIALS_DIRECTORY}/master-key"; the Hub expands it from the variable systemd sets.
LoadCredential=master-key:/etc/credops-hub/master.key

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/credops-hub
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
